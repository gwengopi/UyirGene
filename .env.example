# ================================================================
# Copy this file to .env and fill in all values before deploying
# NEVER commit .env to git
# ================================================================

# ── App ──────────────────────────────────────────────────────────
APP_BASE_URL=https://app.uyirgene.com        # Your subdomain (no trailing slash)
CORS_ALLOWED_ORIGINS=https://app.uyirgene.com

# ── Database ─────────────────────────────────────────────────────
DB_NAME=UyirGene
DB_USERNAME=uyirgene_user                    # Use a non-default username in prod
DB_PASSWORD=CHANGE_ME_strong_password

# ── Security ─────────────────────────────────────────────────────
# Generate JWT_SECRET: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# Generate VIDEO_ENCRYPTION_KEY: openssl rand -hex 32
VIDEO_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Transactional Mail (enrollment, certificates, etc.) ──────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password       # Gmail App Password (not account password)
MAIL_FROM=UyirGene <your_email@gmail.com>

# ── Marketing Mail (optional — bulk campaigns) ────────────────────
# Leave blank to fall back to MAIL_* above
MARKETING_MAIL_HOST=
MARKETING_MAIL_PORT=
MARKETING_MAIL_USERNAME=
MARKETING_MAIL_PASSWORD=

# ── Payment ──────────────────────────────────────────────────────
PAYMENT_PROVIDER=razorpay                   # mock | razorpay
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX
# Webhook secret — configured separately in Razorpay Dashboard > Webhooks
# This is NOT the same as RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXX

# ── Spring Profile ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Cloudflare (used by deploy.sh to purge cache after deployment) ──
# CF_ZONE_ID   → Cloudflare Dashboard → your domain → Overview → Zone ID (right sidebar)
# CF_API_TOKEN → Cloudflare Dashboard → My Profile → API Tokens → Create Token
#                Select template "Cache Purge", scope to this zone
CF_ZONE_ID=
CF_API_TOKEN=
